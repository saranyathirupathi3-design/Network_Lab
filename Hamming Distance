#include<stdio.h>
#include<math.h>

int data[20];
int hamming[20];

int m,r,total;



void inputData()
{
    int i;


    printf("========================================\n");
    printf("          HAMMING CODE - SENDER\n");
    printf("========================================\n");


    printf("\nEnter Binary Data Length : ");
    scanf("%d",&m);



    printf("\nEnter Binary Data : ");

    for(i=0;i<m;i++)
    {
        scanf("%d",&data[i]);
    }



    printf("\n\nSTEP 1 : Input Data\n\n");


    printf("Data Word = ");

    for(i=0;i<m;i++)
        printf("%d",data[i]);


    printf("\n");

}




void parityBits()
{
    r=0;


    printf("\nSTEP 2 : Calculate Number of Parity Bits\n\n");


    printf("Formula : 2^r >= m+r+1\n\n");



    while(pow(2,r)<m+r+1)
    {
        printf("%d >= %d\n",
        (int)pow(2,r),
        m+r+1);


        printf("False\n\n");


        r++;
    }



    printf("%d >= %d\n",
    (int)pow(2,r),
    m+r+1);


    printf("True\n");



    printf("\nNumber of Parity Bits = %d\n",r);



    total=m+r;

}





void placeBits()
{
    int i;
    int d=0;
    int p=0;



    printf("\n\nSTEP 3 : Generate Hamming Code\n\n");


    printf("Bit Placement:\n\n");



    for(i=1;i<=total;i++)
    {

        if(i==(int)pow(2,p))
        {
            hamming[i]=0;
            p++;
        }

        else
        {
            hamming[i]=data[d];
            d++;
        }

    }



    printf("Position : ");


    for(i=1;i<=total;i++)
        printf("%d ",i);



    printf("\nBit      : ");


    for(i=1;i<=total;i++)
        printf("%d ",hamming[i]);



    printf("\n\n");

}




void calculateParity()
{
    int i,j,count;



    printf("Parity Bit Calculation\n");
    printf("----------------------\n\n");



    for(i=0;i<r;i++)
    {

        int pos=(int)pow(2,i);


        count=0;



        printf("Checking P%d\n\n",pos);



        printf("Positions Covered : ");



        for(j=1;j<=total;j++)
        {
            if(j&pos)
                printf("%d ",j);
        }



        printf("\n\nValues : ");



        for(j=1;j<=total;j++)
        {
            if(j&pos)
                printf("%d ",hamming[j]);
        }




        for(j=1;j<=total;j++)
        {
            if((j&pos) && hamming[j]==1)
                count++;
        }



        printf("\n\nNumber of 1's = %d\n",count);



        if(count%2==0)
        {
            hamming[pos]=0;
            printf("Even Count\n");
        }

        else
        {
            hamming[pos]=1;
            printf("Odd Count\n");
        }



        printf("P%d = %d\n\n",
        pos,hamming[pos]);

    }

}





void sendData()
{
    int i;

    FILE *fp;


    fp=fopen("channel.txt","w");



    printf("\n\nFinal Hamming Code\n");
    printf("------------------\n\n");



    printf("Position : ");


    for(i=1;i<=total;i++)
        printf("%d ",i);



    printf("\nBit      : ");


    for(i=1;i<=total;i++)
        printf("%d ",hamming[i]);



    printf("\n\nGenerated Hamming Code = ");



    // Correct order writing

    for(i=1;i<=total;i++)
    {
        printf("%d",hamming[i]);

        fprintf(fp,"%d",hamming[i]);
    }



    fclose(fp);



    printf("\n\nData Sent Successfully\n");

}





int main()
{

    inputData();


    parityBits();


    placeBits();


    calculateParity();


    sendData();



    return 0;
}
