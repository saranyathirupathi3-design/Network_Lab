#include <stdlib.h>

int findCheapestPrice(int n, int** flights, int flightsSize,
                      int* flightsColSize, int src, int dst, int k) {

    int INF = 1000000000;

    /*
        dist[i] = cheapest price to reach city i
        using at most the currently allowed number of flights.
    */
    int* dist = (int*)malloc(n * sizeof(int));
    int* temp = (int*)malloc(n * sizeof(int));

    for (int i = 0; i < n; i++) {
        dist[i] = INF;
    }

    dist[src] = 0;

    /*
        At most k stops means at most k + 1 flights.
    */
    for (int stops = 0; stops <= k; stops++) {

        // Copy previous distances
        for (int i = 0; i < n; i++) {
            temp[i] = dist[i];
        }

        // Relax every flight
        for (int i = 0; i < flightsSize; i++) {

            int from = flights[i][0];
            int to = flights[i][1];
            int price = flights[i][2];

            if (dist[from] != INF &&
                dist[from] + price < temp[to]) {

                temp[to] = dist[from] + price;
            }
        }

        // Update distances
        for (int i = 0; i < n; i++) {
            dist[i] = temp[i];
        }
    }

    int answer;

    if (dist[dst] == INF)
        answer = -1;
    else
        answer = dist[dst];

    free(dist);
    free(temp);

    return answer;
}
