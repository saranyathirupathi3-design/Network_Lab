        {
            printf(" ");
        }
        else
        {
            if(mac[i]>='0' && mac[i]<='9')
            {
                num=mac[i]-'0';
            }
            else if(mac[i]>='A' && mac[i]<='F')
            {
                num=mac[i]-'A'+10;
            }
            else if(mac[i]>='a' && mac[i]<='f')
            {
                num=mac[i]-'a'+10;
            }

            printf("%d",(num/8)%2);
            printf("%d",(num/4)%2);
            printf("%d",(num/2)%2);
            printf("%d",num%2);
        }
    }
}



