void byteStuffing(char input[], char output[])
{
    char flag[] = "01111110";
    char escape[] = "01111101";

    int i = 0, j = 0;
    int k;
    int match;

    while(input[i] != '\0')
    {
        match = 1;

        /* Check Flag */
        for(k = 0; k < 8; k++)
        {
            if(input[i+k] != flag[k])
            {
                match = 0;
                break;
            }
        }

        if(match)
        {
            for(k = 0; k < 8; k++)
                output[j++] = escape[k];

            for(k = 0; k < 8; k++)
                output[j++] = flag[k];

            i = i + 8;
        }
        else
        {
            match = 1;

            /* Check Escape */
            for(k = 0; k < 8; k++)
            {
                if(input[i+k] != escape[k])
                {
                    match = 0;
                    break;
                }
            }

            if(match)
            {
                for(k = 0; k < 8; k++)
                    output[j++] = escape[k];

                for(k = 0; k < 8; k++)
                    output[j++] = escape[k];

                i = i + 8;
            }
            else
            {
                output[j++] = input[i++];
            }
        }
    }

    output[j] = '\0';
}
void byteDestuffing(char input[], char output[])
{
    char flag[] = "01111110";
    char escape[] = "01111101";

    int i = 0, j = 0;
    int k;
    int match;

    while(input[i] != '\0')
    {
        match = 1;

        /* Check Escape + Flag */
        for(k = 0; k < 8; k++)
        {
            if(input[i+k] != escape[k] ||
               input[i+8+k] != flag[k])
            {
                match = 0;
                break;
            }
        }

        if(match)
        {
            for(k = 0; k < 8; k++)
                output[j++] = flag[k];

            i = i + 16;
        }
        else
        {
            match = 1;

            /* Check Escape + Escape */
            for(k = 0; k < 8; k++)
            {
                if(input[i+k] != escape[k] ||
                   input[i+8+k] != escape[k])
                {
                    match = 0;
                    break;
                }
            }

            if(match)
            {
                for(k = 0; k < 8; k++)
                    output[j++] = escape[k];

                i = i + 16;
            }
            else
            {
                output[j++] = input[i++];
            }
        }
    }

    output[j] = '\0';
}
