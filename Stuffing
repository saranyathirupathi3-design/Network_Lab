void binaryToTextStream() {
    int len = strlen(destuffedBinary);
    char currentByte[9];
    currentByte[8] = '\0';
    int outIdx = 0;

    for (int i = 0; i < len; i += 8) {
        strncpy(currentByte, &destuffedBinary[i], 8);
        int val = 0;
        for (int j = 0; j < 8; j++) {
            val = val * 2 + (currentByte[j] - '0');
        }
        finalOutputText[outIdx++] = (char)val;
    }
    finalOutputText[outIdx] = '\0';
}

void bitStuffing(char input[], char output[])
{
    int i;
    int j = 0;
    int count = 0;


    for(i = 0; input[i] != '\0'; i++)
    {
        output[j++] = input[i];


        if(input[i] == '1')
        {
            count++;

            if(count == 5)
            {
                output[j++] = '0';
                count = 0;
            }
        }
        else
        {
            count = 0;
        }
    }


    output[j]='\0';
}
