void protocolToBinary()
{
    int i, j, value, k = 0;

    for(i = 0; protocol[i] != '\0'; i++)
    {
        if(protocol[i] >= '0' && protocol[i] <= '9')
            value = protocol[i] - '0';
        else if(protocol[i] >= 'A' && protocol[i] <= 'F')
            value = protocol[i] - 'A' + 10;
        else if(protocol[i] >= 'a' && protocol[i] <= 'f')
            value = protocol[i] - 'a' + 10;
        else
            continue;

        for(j = 3; j >= 0; j--)
        {
            if(value & (1 << j))
                protocolBinary[k++] = '1';
            else
                protocolBinary[k++] = '0';
        }

        if((i + 1) % 2 == 0 && protocol[i + 1] != '\0')
            protocolBinary[k++] = ' ';
    }

    protocolBinary[k] = '\0';
}
