}
void fragmentDivision()
{
    int i,j,k;
    int length;
    int count;
    int copyLength;
    int len;

    printf("\nEnter Fragment Size : ");
    scanf("%d",&fragmentSize);

    if(fragmentSize<=0 || fragmentSize>=100)
    {
        printf("\nInvalid Fragment Size");
        return;
    }

    totalFragment=0;

    for(i=0;i<totalPacket;i++)
    {
        length=strlen(packet[i]);

        count=length/fragmentSize;

        if(length%fragmentSize!=0)
        {
            count++;
        }

        k=0;

        for(j=0;j<count;j++)
        {
            copyLength=fragmentSize;

            if(k+fragmentSize>length)
            {
                copyLength=length-k;
            }

            strncpy(fragment[totalFragment],&packet[i][k],copyLength);

            fragment[totalFragment][copyLength]='\0';

            while(strlen(fragment[totalFragment])<fragmentSize)
            {
                len=strlen(fragment[totalFragment]);

                fragment[totalFragment][len]='0';
                fragment[totalFragment][len+1]='\0';
            }

            totalFragment++;

            k=k+fragmentSize;
        }
    }
}



void frameDivision()
{
    int i;
    int length;

    printf("\nEnter Frame Size : ");
    scanf("%d", &frameSize);

    if(frameSize <= 0 || frameSize >= 100)
    {
        printf("\nInvalid Frame Size");
        return;
    }

    if(frameSize < fragmentSize)
    {
        printf("\nFrame Size must be greater than or equal to Fragment Size");
        return;
    }

    totalFrame = totalFragment;

    for(i = 0; i < totalFrame; i++)
    {
        
        strcpy(frame[i], fragment[i]);

        
        length = strlen(frame[i]);

        
        paddingBits[i] = 0;

        
        if(frameSize > fragmentSize)
        {
            while(length < frameSize)
            {
                frame[i][length] = '0';
                length++;
                paddingBits[i]++;
            }
        }

        
        frame[i][length] = '\0';
    }
}
