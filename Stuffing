int validateMAC(char mac[])
{
    int i;
    int colonCount=0;


    if(strlen(mac)!=17)
    {
        return 0;
    }


    for(i=0;i<17;i++)
    {
        if((i+1)%3==0)
        {
            if(mac[i]!=':')
            {
                return 0;
            }

            colonCount++;
        }
        else
        {
            if(!((mac[i]>='0' && mac[i]<='9') ||
                 (mac[i]>='A' && mac[i]<='F') ||
                 (mac[i]>='a' && mac[i]<='f')))
            {
                return 0;
            }
        }
    }


    if(colonCount!=5)
    {
        return 0;
    }


    return 1;
}

