#include<stdio.h>

void receiver()
{
    int data[100][7];
    int original[100][7];

    int rowParity[100];
    int colParity[7];

    int newRowParity[100];
    int newColParity[7];

    int rows, cols;

    int i, j;
    int count;

    int choice;
    int errorCount=0;

    int error=0;

    int errorRow[10];
    int errorCol[10];

    int rowError=-1;
    int colError=-1;

    FILE *fp;

    printf("\n========================================");
    printf("\n            RECEIVER SIDE");
    printf("\n========================================\n");

    fp=fopen("sender.txt","r");

    if(fp==NULL)
    {
        printf("\nSender File Not Found");
        return;
    }

    fscanf(fp,"%d%d",&rows,&cols);

    for(i=0;i<rows;i++)
    {
        for(j=0;j<cols;j++)
        {
            fscanf(fp,"%d",&data[i][j]);
            original[i][j]=data[i][j];
        }

        fscanf(fp,"%d",&rowParity[i]);
    }

    for(j=0;j<cols;j++)
    {
        fscanf(fp,"%d",&colParity[j]);
    }

    fclose(fp);

    printf("\nReceived Data\n\n");

    for(i=0;i<rows;i++)
    {
        printf("Row %d : ",i+1);

        for(j=0;j<cols;j++)
        {
            printf("%d",data[i][j]);
        }

        printf(" | %d\n",rowParity[i]);
    }

    printf("\n\nReceived Data\n\n");

    for(i=0;i<rows;i++)
    {
        for(j=0;j<cols;j++)
        {
            printf("%d ",data[i][j]);
        }

        printf("| %d\n",rowParity[i]);
    }

    printf("-------------------\n");

    for(j=0;j<cols;j++)
    {
        printf("%d ",colParity[j]);
    }

    printf("| 0\n");
            printf("\n\n========================================");
    printf("\n       TRANSMISSION CHANNEL");
    printf("\n========================================\n");

    printf("\nDo you want to introduce error?");
    printf("\n1. Yes");
    printf("\n2. No");

    printf("\n\nEnter Choice : ");
    scanf("%d",&choice);

    if(choice==1)
    {
        printf("\nHow many bits you want to change? : ");
        scanf("%d",&errorCount);

        for(i=0;i<errorCount;i++)
        {
            printf("\nEnter Error %d Row Position : ",i+1);
            scanf("%d",&errorRow[i]);

            printf("Enter Error %d Column Position : ",i+1);
            scanf("%d",&errorCol[i]);

            if(data[errorRow[i]-1][errorCol[i]-1]==0)
                data[errorRow[i]-1][errorCol[i]-1]=1;
            else
                data[errorRow[i]-1][errorCol[i]-1]=0;
        }

        printf("\nError Introduced Successfully!\n");
    }


    printf("\n\nReceived Data\n\n");

    for(i=0;i<rows;i++)
    {
        printf("Row %d : ",i+1);

        for(j=0;j<cols;j++)
        {
            printf("%d",data[i][j]);
        }

        printf(" | %d",rowParity[i]);

        if(choice==1 && (i+1)==errorRow[0])
        {
            printf("   <-- Error Row");
        }

        printf("\n");
    }


    printf("\n\nReceived Matrix\n\n");

    for(i=0;i<rows;i++)
    {
        for(j=0;j<cols;j++)
        {
            printf("%d ",data[i][j]);
        }

        printf("| %d",rowParity[i]);

        if(choice==1 && (i+1)==errorRow[0])
        {
            printf("   <-- Error Row");
        }

        printf("\n");

        if(choice==1 && (i+1)==errorRow[0])
        {
            for(j=1;j<errorCol[0];j++)
                printf("  ");

            printf("^");
            printf("\n");
        }
    }

    printf("-------------------\n");

    for(j=0;j<cols;j++)
    {
        printf("%d ",colParity[j]);
    }

    printf("| 0\n");
            printf("\n\n========================================");
    printf("\n        STEP 1 : ROW PARITY CHECK");
    printf("\n========================================\n");

    for(i=0;i<rows;i++)
    {
        count=0;

        for(j=0;j<cols;j++)
        {
            if(data[i][j]==1)
                count++;
        }

        newRowParity[i]=count%2;

        printf("\nRow %d Checking\n",i+1);

        printf("\nReceived Data : ");

        for(j=0;j<cols;j++)
        {
            printf("%d",data[i][j]);
        }

        printf("\n");

        printf("Number of 1's = %d\n",count);

        printf("Expected Parity   = %d\n",rowParity[i]);

        printf("Calculated Parity = %d\n",newRowParity[i]);

        if(newRowParity[i]==rowParity[i])
        {
            printf("\nResult : Correct\n");
        }
        else
        {
            printf("\nResult : Error Detected\n");

            error=1;

            rowError=i;

            printf("\nRow %d contains Error\n",i+1);
        }
    }
            printf("\n\n========================================");
    printf("\n      STEP 2 : COLUMN PARITY CHECK");
    printf("\n========================================\n");

    for(j=0;j<cols;j++)
    {
        count=0;

        for(i=0;i<rows;i++)
        {
            if(data[i][j]==1)
                count++;
        }

        newColParity[j]=count%2;

        printf("\nColumn %d Checking\n",j+1);

        printf("\nColumn Data : ");

        for(i=0;i<rows;i++)
        {
            printf("%d ",data[i][j]);
        }

        printf("\n");

        printf("Number of 1's = %d\n",count);

        printf("Expected Parity   = %d\n",colParity[j]);

        printf("Calculated Parity = %d\n",newColParity[j]);

        if(newColParity[j]==colParity[j])
        {
            printf("\nResult : Correct\n");
        }
        else
        {
            printf("\nResult : Error Detected\n");

            error=1;

            colError=j;

            printf("\nColumn %d contains Error\n",j+1);
        }
    }
            printf("\n\n========================================");
    printf("\n        ERROR DETECTION RESULT");
    printf("\n========================================\n");

    if(error==1)
    {
        printf("\nError Detected\n");

        if(rowError!=-1 && colError!=-1)
        {
            printf("\nError Position Found\n");
            printf("Row    : %d\n",rowError+1);
            printf("Column : %d\n",colError+1);

            printf("\nOriginal Bit : %d\n",original[rowError][colError]);
            printf("Received Bit : %d\n",data[rowError][colError]);

            printf("\nOriginal Data\n");
            printf("Row %d : ",rowError+1);

            for(j=0;j<cols;j++)
            {
                printf("%d",original[rowError][j]);
            }

            printf("\n");

            printf("\nReceived Data\n");
            printf("Row %d : ",rowError+1);

            for(j=0;j<cols;j++)
            {
                printf("%d",data[rowError][j]);
            }

            printf("\n       ");

            for(j=0;j<colError;j++)
            {
                printf(" ");
            }

            printf("^\n");
            printf("       ");

            for(j=0;j<colError;j++)
            {
                printf(" ");
            }

            printf("Error Bit\n");


            /* Error Correction */

            data[rowError][colError]=original[rowError][colError];

            printf("\nCorrected Data\n\n");

            for(i=0;i<rows;i++)
            {
                printf("Row %d : ",i+1);

                for(j=0;j<cols;j++)
                {
                    printf("%d",data[i][j]);
                }

                printf(" | %d\n",rowParity[i]);
            }

            printf("\nCorrected Data\n\n");

            for(i=0;i<rows;i++)
            {
                for(j=0;j<cols;j++)
                {
                    printf("%d ",data[i][j]);
                }

                printf("| %d\n",rowParity[i]);
            }

            printf("-------------------\n");

            for(j=0;j<cols;j++)
            {
                printf("%d ",colParity[j]);
            }

            printf("| 0\n");
        }
        else
        {
            printf("\nMultiple Errors Detected");
            printf("\nExact Error Position Cannot Be Identified\n");
        }
    }
    else
    {
        printf("\nNo Error Detected\n");
    }

    printf("\n\n========================================");

    if(error==1)
    {
        printf("\nTRANSMISSION STATUS : ERROR DETECTED");
    }
    else
    {
        printf("\nTRANSMISSION STATUS : NO ERROR DETECTED");
    }

    printf("\n========================================\n");
}

int main()
{
    receiver();
    return 0;
}
