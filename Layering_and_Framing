void segmentDivision()
{
    int i,j;

    printf("\nEnter Segment Size : ");
    scanf("%d",&segmentSize);

    if(segmentSize<=0 || segmentSize>=200)
    {
        printf("\nInvalid Segment Size");
        return;
    }

    totalSegment=0;

    allBinary[0]='\0';

    for(i=0;i<textLength;i++)
    {
        strcat(allBinary,binaryValue[i]);
    }

    binaryLength=strlen(allBinary);

    i=0;

    while(i<binaryLength)
    {
        j=0;

        while(j<segmentSize && i<binaryLength)
        {
            segment[totalSegment][j]=allBinary[i];
            j++;
            i++;
        }

        while(j<segmentSize)
        {
            segment[totalSegment][j]='0';
            j++;
        }

        segment[totalSegment][segmentSize]='\0';

        totalSegment++;
    }
}



void packetDivision()
{
    int i,j;

    printf("\nEnter Packet Size : ");
    scanf("%d",&packetSize);

    if(packetSize<=0 || packetSize>=200)
    {
        printf("\nInvalid Packet Size");
        return;
    }

    totalPacket=0;

    allBinary[0]='\0';

    for(i=0;i<totalSegment;i++)
    {
        strcat(allBinary,segment[i]);
    }

    binaryLength=strlen(allBinary);

    i=0;

    while(i<binaryLength)
    {
        j=0;

        while(j<packetSize && i<binaryLength)
        {
            packet[totalPacket][j]=allBinary[i];
            j++;
            i++;
        }

        while(j<packetSize)
        {
            packet[totalPacket][j]='0';
            j++;
        }

        packet[totalPacket][packetSize]='\0';

        totalPacket++;
    }
}
void fragmentDivision()
{
    int i,j,k;
    int length;
    int count;
    int copyLength;
    int len;

    printf("\nEnter Fragment Size : ");
    scanf("%d",&fragmentSize);

    if(fragmentSize<=0 || fragmentSize>=100)
    {
        printf("\nInvalid Fragment Size");
        return;
    }

    totalFragment=0;

    for(i=0;i<totalPacket;i++)
    {
        length=strlen(packet[i]);

        count=length/fragmentSize;

        if(length%fragmentSize!=0)
        {
            count++;
        }

        k=0;

        for(j=0;j<count;j++)
        {
            copyLength=fragmentSize;

            if(k+fragmentSize>length)
            {
                copyLength=length-k;
            }

            strncpy(fragment[totalFragment],&packet[i][k],copyLength);

            fragment[totalFragment][copyLength]='\0';

            while(strlen(fragment[totalFragment])<fragmentSize)
            {
                len=strlen(fragment[totalFragment]);

                fragment[totalFragment][len]='0';
                fragment[totalFragment][len+1]='\0';
            }

            totalFragment++;

            k=k+fragmentSize;
        }
    }
}



void frameDivision()
{
    int i;
    int length;

    printf("\nEnter Frame Size : ");
    scanf("%d", &frameSize);

    if(frameSize <= 0 || frameSize >= 100)
    {
        printf("\nInvalid Frame Size");
        return;
    }

    if(frameSize < fragmentSize)
    {
        printf("\nFrame Size must be greater than or equal to Fragment Size");
        return;
    }

    totalFrame = totalFragment;

    for(i = 0; i < totalFrame; i++)
    {
        // முதலில் ஃபிராக்மென்ட் டேட்டாவை அப்படியே ஃபிரேமிற்குள் நகலெடுக்கிறோம்
        strcpy(frame[i], fragment[i]);
        
        // தற்போதைய நீளத்தைக் கணக்கிடுகிறோம்
        length = strlen(frame[i]);
        
        // ஆரம்பத்தில் பேடிங் பிட்கள் 0 என அமைப்போம்
        paddingBits[i] = 0;

        // நிபந்தனை: ஃபிரேம் சைஸ், ஃபிராக்மென்ட் சைஸை விட அதிகமாக இருந்தால் மட்டுமே பேடிங் பிட்கள் சேர்க்கப்படும்
        if(frameSize > fragmentSize)
        {
            while(length < frameSize)
            {
                frame[i][length] = '0';
                length++;
                paddingBits[i]++;
            }
        }
        
        // ஸ்ட்ரிங்கின் முடிவை சரியாக லாக்கிங் செய்கிறோம்
        frame[i][length] = '\0';
    }
}
void decimalToBinary(int num)
{
    int i;
    char binary[9];

    for(i=7;i>=0;i--)
    {
        if(num%2==0)
        {
            binary[i]='0';
        }
        else
        {
            binary[i]='1';
        }

        num=num/2;
    }

    binary[8]='\0';

    printf("%s",binary);
}



void intToBinary16(int num,char binary[])
{
    int i;

    for(i=15;i>=0;i--)
    {
        if(num%2==0)
        {
            binary[i]='0';
        }
        else
        {
            binary[i]='1';
        }

        num=num/2;
    }

    binary[16]='\0';
}



void macToBinary(char mac[])
{
    int i;
    int num;

    for(i=0;mac[i]!='\0';i++)
    {
        if(mac[i]==':')
        {
            printf(":");
        }
        else
        {
            if(mac[i]>='0' && mac[i]<='9')
            {
                num=mac[i]-'0';
            }
            else if(mac[i]>='A' && mac[i]<='F')
            {
                num=mac[i]-'A'+10;
            }
            else if(mac[i]>='a' && mac[i]<='f')
            {
                num=mac[i]-'a'+10;
            }

            printf("%d",(num/8)%2);
            printf("%d",(num/4)%2);
            printf("%d",(num/2)%2);
            printf("%d",num%2);
        }
    }
}



