void addNetworkNode()
{
    if(nodeCount >= 20)
    {
        printf("\nNetwork Table Full");
        return;
    }

    printf("\nEnter URL : ");
    scanf("%s",node[nodeCount].url);


    printf("\nEnter Source IP : ");
    scanf("%d.%d.%d.%d",
          &node[nodeCount].sourceIp[0],
          &node[nodeCount].sourceIp[1],
          &node[nodeCount].sourceIp[2],
          &node[nodeCount].sourceIp[3]);


    printf("\nEnter Destination IP : ");
    scanf("%d.%d.%d.%d",
          &node[nodeCount].destinationIp[0],
          &node[nodeCount].destinationIp[1],
          &node[nodeCount].destinationIp[2],
          &node[nodeCount].destinationIp[3]);


    printf("\nEnter Source MAC : ");
    scanf("%s",node[nodeCount].sourceMac);


    printf("\nEnter Destination MAC : ");
    scanf("%s",node[nodeCount].destinationMac);


    nodeCount++;

    printf("\nNetwork Node Added Successfully\n");

    displayTable();
}



void deleteNetworkNode()
{
    char url[50];
    int i,j;
    int found = 0;


    printf("\nEnter URL to Delete : ");
    scanf("%s",url);


    for(i=0;i<nodeCount;i++)
    {
        if(strcmp(url,node[i].url)==0)
        {
            found = 1;

            for(j=i;j<nodeCount-1;j++)
            {
                node[j] = node[j+1];
            }

            nodeCount--;

            printf("\nRecord Deleted Successfully\n");

            break;
        }
    }


    if(found==0)
    {
        printf("\nURL Not Found\n");
    }

    displayTable();
}



