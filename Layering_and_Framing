void networkLayer()
{
    int i;
    int fragmentNo = 1;
    char sourceIp[20];
    char destinationIp[20];

    printf("\n");
    printf("\n======================================================================");
    printf("\n                        NETWORK LAYER");
    printf("\n======================================================================");

    printf("\n");
    printf("\nHEADER");
    printf("\n--------------------------------------------------");

    

    printf("\nDestination IP (Decimal) : ");
    destinationIpDecimal();

    printf("\n");

    printf("\nSource IP (Binary)       : ");
    sourceIpBinary();

    printf("\nDestination IP (Binary)  : ");
    destinationIpBinary();

    printf("\n");

    printf("\nIP Header Added Successfully");


    sprintf(sourceIp,"%d.%d.%d.%d",
            node[sourceIndex].sourceIp[0],
            node[sourceIndex].sourceIp[1],
            node[sourceIndex].sourceIp[2],
            node[sourceIndex].sourceIp[3]);


    sprintf(destinationIp,"%d.%d.%d.%d",
            node[destinationIndex].destinationIp[0],
            node[destinationIndex].destinationIp[1],
            node[destinationIndex].destinationIp[2],
            node[destinationIndex].destinationIp[3]);


    printf("\n");

    printf("\n+--------+--------------------+--------------------+----------------------------------+");
    printf("\n| Packet | Source IP          | Destination IP     | Packet Binary Data               |");
    printf("\n+--------+--------------------+--------------------+----------------------------------+");


    for(i=0;i<totalPacket;i++)
    {
        printf("\n| ");

        printf("%d",i+1);
        printSpaces(6);

        printf("| ");

        printf("%s",sourceIp);
        printSpaces(19-strlen(sourceIp));

        printf("| ");

        printf("%s",destinationIp);
        printSpaces(19-strlen(destinationIp));

        printf("| ");

        printf("%s",packet[i]);
        printSpaces(33-strlen(packet[i]));

        printf("|");
    }


    printf("\n+--------+--------------------+--------------------+----------------------------------+");


    /* Combined Packet Stream */

    printf("\n\nCombined Packet Stream");

    for(i=0;i<totalPacket;i++)
    {
        printf("\nPacket %d : %s",i+1,packet[i]);
    }



    /* Fragmentation */

    printf("\n\nFragmentation");
    printf("\n--------------------------------------------------");


    fragmentNo = 1;


    for(i=0;i<totalPacket;i++)
    {
        int len;
        int j;

        len = strlen(packet[i]);


        printf("\n\nPacket %d Fragments",i+1);


        for(j=0;j<len;j+=fragmentSize)
        {

            printf("\nFragment %d : ",fragmentNo);


            int k;


            for(k=j;k<j+fragmentSize && k<len;k++)
            {
                printf("%c",packet[i][k]);
            }


            fragmentNo++;

        }
    }


    printf("\n");
}
void dataLinkLayer()
{
    int i;

    printf("\n");
    printf("\n========================================================================================================================");
    printf("\n                                         DATA LINK LAYER");
    printf("\n========================================================================================================================");


    printf("\nDATA LINK HEADER");
    printf("\n----------------");


    printf("\nSource MAC Address      : %s", node[sourceIndex].sourceMac);

    printf("\nSource MAC Binary       : ");
    sourceMacBinary();


    printf("\n");

    printf("\nDestination MAC Address : %s", node[destinationIndex].destinationMac);

    printf("\nDestination MAC Binary  : ");
    destinationMacBinary();


    printf("\n");


    printf("\n+-------+------------------+------------------+--------------------------+--------------+---------------+");
    printf("\n| Frame | Source MAC       | Destination MAC  | Payload Data             | Padding Bits | Error Control |");
    printf("\n+-------+------------------+------------------+--------------------------+--------------+---------------+");


    for(i = 0; i < totalFrame; i++)
    {
        printf("\n| ");

        // Frame Number
        printf("%d", i + 1);
        printSpaces(5);


        printf("| ");


        // Source MAC
        printf("%s", node[sourceIndex].sourceMac);
        printSpaces(17 - strlen(node[sourceIndex].sourceMac));


        printf("| ");


        // Destination MAC
        printf("%s", node[destinationIndex].destinationMac);
        printSpaces(17 - strlen(node[destinationIndex].destinationMac));


        printf("| ");


        // Payload + Padding already added in frame[]
        printf("%s", frame[i]);
        printSpaces(25 - strlen(frame[i]));


        printf("| ");


        // Padding Bits
        printf("%d", paddingBits[i]);
        printSpaces(12);


        printf("| ");


        // Error Control
        printf("00000000");
        printSpaces(7);


        printf("|");
    }


    printf("\n+-------+------------------+------------------+--------------------------+--------------+---------------+");


    printf("\n");
}
