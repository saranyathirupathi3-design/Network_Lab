void readFile()
{
    FILE *fp;
    char ch;
    int i=0;

    printf("\nEnter File Name : ");
    scanf("%s",fileName);

    fp=fopen(fileName,"r");

    if(fp==NULL)
    {
        printf("\nFile Not Found\n");
        return;
    }

    while((ch=fgetc(fp))!=EOF)
    {
        text[i]=ch;
        i++;
    }

    text[i]='\0';

    fclose(fp);

    printf("\nFile Read Successfully");

    printf("\n\nFile Name : %s\n",fileName);
}



void textToAscii()
{
    int i;

    textLength=0;

    for(i=0;text[i]!='\0';i++)
    {
        asciiValue[i]=text[i];
        textLength++;
    }
}



void asciiToBinary()
{
    int i,j;
    int num;

    for(i=0;i<textLength;i++)
    {
        num=asciiValue[i];

        for(j=7;j>=0;j--)
        {
            if(num%2==0)
            {
                binaryValue[i][j]='0';
            }
            else
            {
                binaryValue[i][j]='1';
            }

            num=num/2;
        }

        binaryValue[i][8]='\0';
    }
}

void generatePort()
{
    srand(time(NULL));

    sourcePort=rand()%50000+1000;
    destinationPort=rand()%50000+1000;

    intToBinary16(sourcePort,sourcePortBinary);
    intToBinary16(destinationPort,destinationPortBinary);
}



void searchUrl()
{
    int i;
    int sourceFound=0;
    int destinationFound=0;

    printf("\nEnter Source URL : ");
    scanf("%s",sourceUrl);

    printf("\nEnter Destination URL : ");
    scanf("%s",destinationUrl);

    for(i=0;i<nodeCount;i++)
    {
        if(strcmp(sourceUrl,node[i].url)==0)
        {
            sourceIndex=i;
            sourceFound=1;
        }

        if(strcmp(destinationUrl,node[i].url)==0)
        {
            destinationIndex=i;
            destinationFound=1;
        }
    }

    printf("\n");

    if(sourceFound==1)
    {
        printf("Source URL Found");
    }
    else
    {
        printf("Source URL Not Found");
    }

    printf("\n");

    if(destinationFound==1)
    {
        printf("Destination URL Found");
    }
    else
    {
        printf("Destination URL Not Found");
    }

    printf("\n");
}



