void bitStuffing(char input[], char output[])
{
    int i;
    int j = 0;
    int count = 0;


    for(i = 0; input[i] != '\0'; i++)
    {
        output[j++] = input[i];


        if(input[i] == '1')
        {
            count++;

            if(count == 5)
            {
                output[j++] = '0';
                count = 0;
            }
        }
        else
        {
            count = 0;
        }
    }


    output[j]='\0';
}
