void generateChecksum(char data[], char checksum[])
{
    int i,j;
    int len;
    char block[9];
    char sum[9];

    len=strlen(data);

    strcpy(sum,"00000000");

    printf("\n\n========================================================");
    printf("\n          CHECKSUM GENERATION (SENDER)");
    printf("\n========================================================");

    for(i=0;i<len;i=i+8)
    {
        for(j=0;j<8;j++)
        {
            if(i+j<len)
                block[j]=data[i+j];
            else
                block[j]='0';
        }

        block[8]='\0';

        printf("\nBlock %2d : %s",(i/8)+1,block);

        printf("\nPrevious Sum : %s",sum);
        printf("\nAdd Block    : %s",block);

        binaryAddition(sum,block,sum);

        printf("\nNew Sum      : %s\n",sum);
    }

    printf("\n----------------------------------------");
    printf("\nFinal Sum Before Complement : %s",sum);

    strcpy(checksum,sum);

    onesComplement(checksum);

    printf("\n1's Complement              : %s",checksum);
    printf("\n----------------------------------------");
}
int verifyChecksum(char data[], char receivedChecksum[])
{
    int i,j;
    int len;

    char block[9];
    char sum[9];

    len=strlen(data);

    strcpy(sum,"00000000");

    printf("\n\n========================================================");
    printf("\n         CHECKSUM VERIFICATION (RECEIVER)");
    printf("\n========================================================");

    /* Add all data blocks */

    for(i=0;i<len;i=i+8)
    {
        for(j=0;j<8;j++)
        {
            if(i+j<len)
                block[j]=data[i+j];
            else
                block[j]='0';
        }

        block[8]='\0';

        printf("\nBlock %2d : %s",(i/8)+1,block);

        printf("\nPrevious Sum : %s",sum);
        printf("\nAdd Block    : %s",block);

        binaryAddition(sum,block,sum);

        printf("\nNew Sum      : %s\n",sum);
    }

    printf("\n========================================================");
    printf("\nADD RECEIVED CHECKSUM");
    printf("\n========================================================");

    printf("\nCurrent Sum       : %s",sum);
    printf("\nReceived Checksum : %s",receivedChecksum);

    binaryAddition(sum,receivedChecksum,sum);

    printf("\nFinal Sum         : %s",sum);

    printf("\n========================================================");

    if(strcmp(sum,"11111111")==0)
    {
        printf("\nChecksum Result : CORRECT");
        return 1;
    }
    else
    {
        printf("\nChecksum Result : ERROR");
        return 0;
    }
}
