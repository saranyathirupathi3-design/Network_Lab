void separateChecksum(char input[],
                      char data[],
                      char checksum[])
{
    int i;
    int len;

    len=strlen(input);

    for(i=0;i<len-8;i++)
    {
        data[i]=input[i];
    }

    data[len-8]='\0';

    for(i=0;i<8;i++)
    {
        checksum[i]=input[len-8+i];
    }

    checksum[8]='\0';
}
