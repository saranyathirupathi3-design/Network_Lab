void protocolToBinary()
{
    int i, j, value, k = 0;

    for(i = 0; protocol[i] != '\0'; i++)
    {
        if(protocol[i] >= '0' && protocol[i] <= '9')
            value = protocol[i] - '0';
        else if(protocol[i] >= 'A' && protocol[i] <= 'F')
            value = protocol[i] - 'A' + 10;
        else if(protocol[i] >= 'a' && protocol[i] <= 'f')
            value = protocol[i] - 'a' + 10;
        else
            continue;

        for(j = 3; j >= 0; j--)
        {
            if(value & (1 << j))
                protocolBinary[k++] = '1';
            else
                protocolBinary[k++] = '0';
        }

        if((i + 1) % 2 == 0 && protocol[i + 1] != '\0')
            protocolBinary[k++] = ' ';
    }

    protocolBinary[k] = '\0';
}
void binaryAddition(char a[], char b[], char result[])
{
    int i;
    int sum;
    int carry = 0;

    char temp[9];

    /* Normal binary addition */

    for(i=7;i>=0;i--)
    {
        sum=(a[i]-'0')+(b[i]-'0')+carry;

        if(sum==0)
        {
            temp[i]='0';
            carry=0;
        }
        else if(sum==1)
        {
            temp[i]='1';
            carry=0;
        }
        else if(sum==2)
        {
            temp[i]='0';
            carry=1;
        }
        else
        {
            temp[i]='1';
            carry=1;
        }
    }

    /* End-around carry */

    while(carry)
    {
        carry=0;

        for(i=7;i>=0;i--)
        {
            if(i==7)
                sum=(temp[i]-'0')+1;
            else
                sum=(temp[i]-'0')+carry;

            if(sum==0)
            {
                temp[i]='0';
                carry=0;
            }
            else if(sum==1)
            {
                temp[i]='1';
                carry=0;
            }
            else if(sum==2)
            {
                temp[i]='0';
                carry=1;
            }
        }
    }

    temp[8]='\0';

    strcpy(result,temp);
}
