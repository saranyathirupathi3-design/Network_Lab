void segmentDivision()
{
    int i,j;

    printf("\nEnter Segment Size : ");
    scanf("%d",&segmentSize);

    if(segmentSize<=0 || segmentSize>=200)
    {
        printf("\nInvalid Segment Size");
        return;
    }

    totalSegment=0;

    allBinary[0]='\0';

    for(i=0;i<textLength;i++)
    {
        strcat(allBinary,binaryValue[i]);
    }

    binaryLength=strlen(allBinary);

    i=0;

    while(i<binaryLength)
    {
        j=0;

        while(j<segmentSize && i<binaryLength)
        {
            segment[totalSegment][j]=allBinary[i];
            j++;
            i++;
        }

        while(j<segmentSize)
        {
            segment[totalSegment][j]='0';
            j++;
        }

        segment[totalSegment][segmentSize]='\0';

        totalSegment++;
    }
}



