int totalHammingDistance(int* nums, int numsSize) {
    int total_distance = 0;
    
    // Iterate through each of the 32 bit positions
    for (int i = 0; i < 32; i++) {
        int count_ones = 0;
        
        // Count how many numbers have the i-th bit set to 1
        for (int j = 0; j < numsSize; j++) {
            if ((nums[j] >> i) & 1) {
                count_ones++;
            }
        }
        
        // Number of zeros at the i-th bit position
        int count_zeros = numsSize - count_ones;
        
        // Each combination of a 1 and a 0 contributes 1 to the distance
        total_distance += count_ones * count_zeros;
    }
    
    return total_distance;
}
