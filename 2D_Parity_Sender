#include<stdio.h>

void sender()
{
    int data[100][7];
    int rowParity[100];
    int colParity[7];

    int rows=0;
    int cols=7;

    int i,j,count;

    char text[100];
    char binary[8];
    char ch;

    FILE *fp,*fp1;

    printf("\n========================================");
    printf("\n             2D PARITY CHECK");
    printf("\n========================================\n");


    fp=fopen("input.txt","r");

    if(fp==NULL)
    {
        printf("\nInput File Not Found");
        return;
    }


    printf("\nReading Data From input.txt...\n");

    printf("\nOriginal Text :\n\n");


    while((ch=fgetc(fp))!=EOF)
    {
        if(ch!='\n')
        {
            printf("%c",ch);
            text[rows]=ch;
            rows++;
        }
    }

    text[rows]='\0';

    fclose(fp);


    printf("\n\n7-Bit Binary Data\n\n");


    for(i=0;i<rows;i++)
    {
        int ascii=text[i];

        for(j=6;j>=0;j--)
        {
            binary[6-j]=((ascii>>j)&1)+'0';
        }

        binary[7]='\0';

        printf("%c = %s\n",text[i],binary);

        for(j=0;j<7;j++)
        {
            data[i][j]=binary[j]-'0';
        }
    }


    printf("\n\n========================================");
    printf("\n            SENDER SIDE");
    printf("\n========================================");
	    // Row Parity

    printf("\n\nGenerating Row Parity Bits...\n");

    for(i=0;i<rows;i++)
    {
        count=0;

        for(j=0;j<cols;j++)
        {
            if(data[i][j]==1)
                count++;
        }

        rowParity[i]=count%2;

        printf("\nRow %d : Number of 1's = %d",i+1,count);
        printf("\nRow %d Parity Bit = %d\n",i+1,rowParity[i]);
    }


    // Column Parity

    printf("\nGenerating Column Parity Bits...\n");

    for(j=0;j<cols;j++)
    {
        count=0;

        for(i=0;i<rows;i++)
        {
            if(data[i][j]==1)
                count++;
        }

        colParity[j]=count%2;

        printf("\nColumn %d : Number of 1's = %d",j+1,count);
        printf("\nColumn %d Parity Bit = %d\n",j+1,colParity[j]);
    }


    // Transmitted Matrix

    printf("\n\nTransmitted Matrix\n\n");

    for(i=0;i<rows;i++)
    {
        for(j=0;j<cols;j++)
        {
            printf("%d ",data[i][j]);
        }

        printf("| %d\n",rowParity[i]);
    }

    printf("-------------------\n");

    for(j=0;j<cols;j++)
    {
        printf("%d ",colParity[j]);
    }

    printf("| 0\n");


    // Write into sender.txt

    fp1=fopen("sender.txt","w");

    fprintf(fp1,"%d %d\n",rows,cols);

    for(i=0;i<rows;i++)
    {
        for(j=0;j<cols;j++)
        {
            fprintf(fp1,"%d ",data[i][j]);
        }

        fprintf(fp1,"%d\n",rowParity[i]);
    }

    for(j=0;j<cols;j++)
    {
        fprintf(fp1,"%d ",colParity[j]);
    }

    fprintf(fp1,"0");

    fclose(fp1);

    printf("\nData Written Successfully To sender.txt\n");
}

int main()
{
    sender();
    return 0;
}
